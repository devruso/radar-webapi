# RADAR database (local Docker defaults)
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# RADAR API
RADAR_API_PORT=9090
RADAR_LOG_LEVEL=INFO
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
RADAR_CATALOG_SYNC_KEY=change-me
RADAR_OFERTAS_IMPORT_KEY=change-me
RADAR_JWT_SECRET=replace-with-at-least-32-random-characters
RADAR_TOKEN_TTL=PT12H
RADAR_ALLOWED_ORIGINS=http://localhost:3000,https://your-radar.vercel.app

# Ementas is read-only. These credentials are never persisted by RADAR.
EMENTAS_API_BASE_URLS=http://host.docker.internal:3333/api,https://ementas.app.ic.ufba.br/api
EMENTAS_API_EMAIL=
EMENTAS_API_PASSWORD=
